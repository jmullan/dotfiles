#!/usr/bin/env -S python-venv --virtualenv dotfiles
import logging
import os
import subprocess
import sys
from datetime import datetime
from jmullan.cmd import cmd
from jmullan.logging.easy_logging import easy_initialize_logging

logger = logging.getLogger(__name__)

DEBUG = sys.argv and "--debug" in sys.argv or os.environ.get("DEBUG_PROMPT") == "true"

class DurationTracked:
    def __init__(self, item: str, timing: str):
        self.timing = timing
        self.item = item


def popen(command: list[str]):
    if DEBUG:
        command = ["time"] + command
        logger.debug(command)
    return subprocess.Popen(
        command, stdout=subprocess.PIPE, stderr=subprocess.PIPE, encoding="UTF-8", text=True
    )


def main():
    if DEBUG:
        easy_initialize_logging("DEBUG", sys.stderr)
    else:
        easy_initialize_logging("INFO", sys.stderr)
    cmd.handle_keyboard_interrupt()
    cmd.stop_on_broken_pipe_error()

    start = datetime.now()
    now_string = start.strftime("[%Y-%m-%d %H:%M:%S]")
    commands = [
        "ssh-agent-prompt",
        "docker_prompt",
        "aws-prompt",
        "sc-prompt",
        "nvm-prompt",
        "screen_prompt",
        "virtualenv_prompt",
        "sdk-prompt",
        "git-prompt",
    ]

    procs: dict[str, subprocess.Popen] = {command: popen([command]) for command in commands}

    outputs: dict[str, DurationTracked] = {}
    for command, p in procs.items():
        logger.debug("Waiting for %s", command)
        output = p.communicate()
        d = DurationTracked(output[0], output[1])
        outputs[command] = d

    # Combine and print as one line
    items = [o.item for o in outputs.values() if o is not None]
    items = [o.strip() for o in items]
    items = [o for o in items if len(o) > 0]
    print(" ".join([now_string] + items))

    if DEBUG:
        total_elapsed = datetime.now() - start
        outputs["total"] = DurationTracked("", f"{total_elapsed.total_seconds():.2f}")
        max_width = max(len(command) for command in outputs)
        for command, duration_tracked in outputs.items():
            logger.debug(
                f"{command:{max_width}}\t{duration_tracked.timing.strip()}\t{duration_tracked.item.strip()}"
            )

if __name__ == "__main__":
    main()
