*.p=$source
*.pod=$source
*.tex=$source
*.go=$source
*.sql=$source
*.sv=$source
*.svh=$source
*.v=$source
*.vh=$source
*.vhd=$source

# log files
$log=
*.0=$source
*.1=$source
*.2=$source
*.3=$source
*.4=$source
*.5=$source
*.6=$source
*.7=$source
*.8=$source
*.9=$source

# Config / structured data — yellow
$structured=00;33
*.json=$structured
*.yaml=$structured
*.yml=$structured
*.toml=$structured
*.ini=$structured
*.conf=$structured
*.cfg=$structured
*.properties=$structured
*.xml=$structured
*.csv=$structured
